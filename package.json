  "description": "WhatsApp Bot para organização de cronograma de cultos com Baileys, Gemini AI, Playwright e Painel Web do Sonoplasta",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
