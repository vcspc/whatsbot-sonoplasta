    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
