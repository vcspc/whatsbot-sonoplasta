# Porta do Servidor Web
PORT=3000

# Chave de API do Google Gemini (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=

# Número de telefone do Sonoplasta com DDI e DDD (ex: 5511999998888)
SONOPLASTA_PHONE=

# Nome do Bot para mensagens
BOT_NAME=WhatsBot Sonoplasta

# Fuso horário do Sonoplasta / Igreja (padrão: America/Sao_Paulo)
TIMEZONE=America/Sao_Paulo

# Horário padrão de envio dos lembretes da véspera (formato HH:MM, padrão: 09:00)
REMINDER_TIME=09:00

# Ngrok - Acesso Remoto pela Internet
# Obtenha seu authtoken gratuito em https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Domínio estático opcional (ex: seu-subdominio.ngrok-free.app)
NGROK_DOMAIN=
# Habilitar ou desabilitar o túnel ngrok (true/false, padrão: true)
NGROK_ENABLED=true

# Credenciais de Acesso ao Painel Web (Login Coletivo)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

